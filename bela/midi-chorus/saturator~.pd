#N canvas 0 0 800 600 12;
#X obj 50 30 inlet~;
#X obj 150 30 inlet~;
#X obj 50 550 outlet~;
#X obj 150 550 outlet~;
#X text 250 10 Stereo Soft Saturator - Harmonic Exciter;
#X text 250 30 Cubic waveshaping: x - x^3/3 (generates 3rd harmonics);
#X obj 350 80 r sat-drive;
#X obj 350 100 pack 0 30;
#X obj 350 120 line~;
#X text 450 80 Drive amount (1-10);
#X obj 350 180 r sat-mix;
#X obj 350 200 pack 0 30;
#X obj 350 220 line~;
#X text 450 180 Wet/dry mix (0-1);
#X obj 350 260 expr~ 1-$v1;
#X text 450 260 Dry amount (1-mix);
#X obj 50 100 *~;
#X obj 150 100 *~;
#X text 250 100 Input * drive;
#X obj 50 150 clip~ -1.5 1.5;
#X obj 150 150 clip~ -1.5 1.5;
#X text 250 150 Pre-clip to prevent runaway;
#X obj 50 200 expr~ $v1 - $v1*$v1*$v1/3;
#X obj 150 200 expr~ $v1 - $v1*$v1*$v1/3;
#X text 250 200 Cubic soft clip (3rd harmonics);
#X obj 50 250 *~ 0.75;
#X obj 150 250 *~ 0.75;
#X text 250 250 Normalize output level;
#X obj 50 320 *~;
#X obj 150 320 *~;
#X text 250 320 Wet * mix;
#X obj 50 370 *~;
#X obj 150 370 *~;
#X text 250 370 Dry * (1-mix);
#X obj 50 440 +~;
#X obj 150 440 +~;
#X text 250 440 Wet + dry;
#X connect 0 0 16 0;
#X connect 0 0 31 0;
#X connect 1 0 17 0;
#X connect 1 0 32 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 8 0 16 1;
#X connect 8 0 17 1;
#X connect 10 0 11 0;
#X connect 11 0 12 0;
#X connect 12 0 14 0;
#X connect 12 0 28 1;
#X connect 12 0 29 1;
#X connect 14 0 31 1;
#X connect 14 0 32 1;
#X connect 16 0 19 0;
#X connect 17 0 20 0;
#X connect 19 0 22 0;
#X connect 20 0 23 0;
#X connect 22 0 25 0;
#X connect 23 0 26 0;
#X connect 25 0 28 0;
#X connect 26 0 29 0;
#X connect 28 0 34 0;
#X connect 29 0 35 0;
#X connect 31 0 34 1;
#X connect 32 0 35 1;
#X connect 34 0 2 0;
#X connect 35 0 3 0;
